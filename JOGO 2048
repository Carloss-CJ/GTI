        print("\n" * 40)
    else:
        os.system("cls" if os.name == "nt" else "clear")




def formatar_tempo(segundos):
    """Transforma segundos em texto MM:SS. Exemplo: 125 -> '02:05'."""
    minutos = segundos // 60
    resto = segundos % 60
    return f"{minutos:02d}:{resto:02d}"




def formatar_pontos(pontos):
    """Pontos com 7 dígitos, igual fliperama antigo. Exemplo: 340 -> '0000340'."""
    return f"{pontos:07d}"




