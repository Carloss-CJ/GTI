# PARTE 3 - LÓGICA DOS MOVIMENTOS                                (Integrante 3)
# ------------------------------------------------------------------------------
# O coração do jogo. A ideia principal: só ensinamos o computador a mover UMA
# linha para a ESQUERDA. Para as outras direções, giramos o tabuleiro, movemos
# para a esquerda e desviramos.
# ==============================================================================


def deslizar_linha(linha):
    """Empurra uma linha para a ESQUERDA juntando as peças iguais.
    Exemplo: [2, 2, 4, 0] -> [4, 4, 0, 0] e ganha 4 pontos.
    Cada peça só pode juntar UMA vez por jogada: [2, 2, 2, 2] -> [4, 4, 0, 0]."""
    # 1) tira os zeros:  [2, 0, 2, 4] -> [2, 2, 4]
    numeros = []
    for valor in linha:
        if valor != 0:
            numeros.append(valor)


    # 2) junta vizinhos iguais, da esquerda para a direita
    nova_linha = []
    pontos = 0
    i = 0
    while i < len(numeros):
        if i + 1 < len(numeros) and numeros[i] == numeros[i + 1]:
            soma = numeros[i] * 2
            nova_linha.append(soma)
            pontos += soma
            i += 2            # pula as duas peças que viraram uma
        else:
            nova_linha.append(numeros[i])
            i += 1


    # 3) completa com zeros no final até a linha ter 4 casas de novo
    while len(nova_linha) < TAMANHO:
        nova_linha.append(0)


    return nova_linha, pontos




def inverter(tabuleiro):
    """Espelha o tabuleiro: cada linha fica de trás para frente."""
    novo = []
    for linha in tabuleiro:
        novo.append(linha[::-1])   # [::-1] = lista ao contrário
    return novo




def transpor(tabuleiro):
    """Troca linhas por colunas: a coluna 0 vira a linha 0, e assim por diante."""
    novo = []
    for coluna in range(TAMANHO):
        nova_linha = []
        for linha in range(TAMANHO):
            nova_linha.append(tabuleiro[linha][coluna])
        novo.append(nova_linha)
    return novo




def mover(tabuleiro, direcao):
    """Faz a jogada na direção pedida (W, A, S ou D).
       A (esquerda): desliza direto
       D (direita):  inverte  -> desliza -> inverte de volta
       W (cima):     transpõe -> desliza -> transpõe de volta
       S (baixo):    transpõe e inverte -> desliza -> desfaz as duas coisas
    Devolve: (tabuleiro_novo, pontos_ganhos, se_algo_mudou)."""
    # 1) vira o tabuleiro para que a direção pedida vire "esquerda"
    if direcao == "D":
        virado = inverter(tabuleiro)
    elif direcao == "W":
        virado = transpor(tabuleiro)
    elif direcao == "S":
        virado = inverter(transpor(tabuleiro))
    else:
        virado = tabuleiro


    # 2) desliza cada linha para a esquerda e soma os pontos
    deslizado = []
    pontos = 0
    for linha in virado:
        nova_linha, ganho = deslizar_linha(linha)
        deslizado.append(nova_linha)
        pontos += ganho


    # 3) desvira, fazendo as operações na ordem contrária
    if direcao == "D":
        novo = inverter(deslizado)
    elif direcao == "W":
        novo = transpor(deslizado)
    elif direcao == "S":
        novo = transpor(inverter(deslizado))
    else:
        novo = deslizado


    mudou = novo != tabuleiro
    return novo, pontos, mudou




def pode_mover(tabuleiro):
    """Diz se ainda existe jogada: tem casa vazia OU duas peças iguais
    vizinhas (lado a lado ou uma em cima da outra)."""
    for linha in range(TAMANHO):
        for coluna in range(TAMANHO):
            valor = tabuleiro[linha][coluna]
            if valor == 0:
                return True
            if coluna + 1 < TAMANHO and valor == tabuleiro[linha][coluna + 1]:
                return True
            if linha + 1 < TAMANHO and valor == tabuleiro[linha + 1][coluna]:
                return True
    return False




