# PARTE 5 - PARTIDA, FIM DE JOGO E MENU                          (Integrante 5)
# ------------------------------------------------------------------------------
# Junta tudo: pede o apelido, liga o cronômetro, repete o ciclo
# "mostrar -> ler jogada -> mover -> nascer peça" até o jogo acabar,
# salva a partida e mostra a tela final. O menu é o ponto de partida.
# ==============================================================================


def pedir_apelido():
    """Pede o apelido até ele ser válido: 1 a 10 caracteres e sem ';'."""
    while True:
        apelido = input(f"  Digite seu apelido (até {MAX_APELIDO} letras): ").strip().upper()
        if len(apelido) == 0:
            print("  O apelido não pode ficar vazio.")
        elif len(apelido) > MAX_APELIDO:
            print(f"  Use no máximo {MAX_APELIDO} caracteres.")
        elif ";" in apelido:
            print("  Não use ponto e vírgula (;) no apelido.")
        else:
            return apelido




def tela_fim_de_jogo(apelido, pontos, segundos, maior, jogadas, posicao, novo_recorde, venceu):
    """Mostra o resultado final: pontuação, tempo e posição no ranking."""
    limpar_tela()
    print("  ##########################################")
    print("  #                                        #")
    if venceu:
        print("  #        V O C Ê   V E N C E U !         #")
    else:
        print("  #           G A M E   O V E R            #")
    print("  #                                        #")
    print("  ##########################################")
    print()
    print(f"  Jogador ............ {apelido}")
    print(f"  Pontuação .......... {formatar_pontos(pontos)}")
    print(f"  Tempo de jogo ...... {formatar_tempo(segundos)}")
    print(f"  Maior peça ......... {maior}")
    print(f"  Jogadas ............ {jogadas}")
    print(f"  Posição no ranking . {posicao}º lugar")
    if novo_recorde:
        print()
        print("  ****************************************")
        print("  *   NOVO RECORDE! VOCÊ É O NÚMERO 1    *")
        print("  ****************************************")
    pausar()




def jogar():
    """Uma partida completa, do apelido até a tela de fim de jogo."""
    limpar_tela()
    mostrar_titulo()
    apelido = pedir_apelido()


    tabuleiro = criar_tabuleiro()
    pontos = 0
    jogadas = 0
    recorde = obter_recorde()
    venceu = False
    mensagem = f"Boa sorte, {apelido}! Chegue ao 2048."
    inicio = time.time()               # liga o cronômetro


    while True:
        segundos = int(time.time() - inicio)
        mostrar_tabuleiro(tabuleiro, apelido, pontos, max(recorde, pontos),
                          segundos, jogadas, mensagem)


        if not pode_mover(tabuleiro):
            print("\n  Não há mais movimentos possíveis!")
            break


        jogada = input("  Sua jogada: ").strip().upper()
        if jogada == "Q":
            segundos = int(time.time() - inicio)
            print("\n  Você desistiu da partida.")
            break
        if jogada not in ("W", "A", "S", "D"):
            mensagem = "Tecla inválida! Use W, A, S ou D."
            continue


        tabuleiro_novo, ganho, mudou = mover(tabuleiro, jogada)
        if not mudou:
            mensagem = "Nada se mexeu. Tente outra direção."
            continue


        maior_antes = maior_peca(tabuleiro)
        tabuleiro = tabuleiro_novo
        pontos += ganho
        jogadas += 1
        adicionar_peca(tabuleiro)


        if ganho > 0:
            mensagem = f"+{ganho} pontos!"
        else:
            mensagem = "..."
        if maior_peca(tabuleiro) > maior_antes and maior_peca(tabuleiro) >= 128:
            mensagem += f"  Nova maior peça: {maior_peca(tabuleiro)}!"


        # Chegou ao 2048 pela primeira vez nesta partida?
        if maior_peca(tabuleiro) >= META and not venceu:
            venceu = True
            segundos = int(time.time() - inicio)
            mostrar_tabuleiro(tabuleiro, apelido, pontos, max(recorde, pontos),
                              segundos, jogadas, "*** PARABÉNS! VOCÊ FEZ 2048! ***")
            resposta = input("  Continuar jogando para fazer mais pontos? (S/N): ").strip().upper()
            if resposta != "S":
                break
            mensagem = "Modo infinito! Até onde você chega?"


    pausar()
    maior = maior_peca(tabuleiro)
    if jogadas == 0:
        print("  Partida sem nenhuma jogada não entra no placar.")
        pausar()
        return


    posicao = calcular_posicao(pontos, segundos)   # calcula ANTES de salvar
    novo_recorde = pontos > recorde
    salvar_partida(apelido, pontos, segundos, maior, jogadas)
    tela_fim_de_jogo(apelido, pontos, segundos, maior, jogadas, posicao, novo_recorde, venceu)




