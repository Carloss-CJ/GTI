# PARTE 2 - TABULEIRO E DESENHO NA TELA                          (Integrante 2)
# ------------------------------------------------------------------------------
# O tabuleiro é uma MATRIZ: uma lista com 4 listas (linhas) de 4 números cada.
# O número 0 representa uma casa vazia. Exemplo:
#     [[2, 0, 0, 0],
#      [0, 4, 0, 0],
#      [0, 0, 0, 0],
#      [0, 0, 0, 2]]
# ==============================================================================


def criar_tabuleiro():
    """Cria a matriz 4x4 cheia de zeros e coloca as 2 primeiras peças."""
    tabuleiro = []
    for _ in range(TAMANHO):
        tabuleiro.append([0] * TAMANHO)
    adicionar_peca(tabuleiro)
    adicionar_peca(tabuleiro)
    return tabuleiro




def casas_vazias(tabuleiro):
    """Devolve uma lista com as posições (linha, coluna) que valem 0."""
    vazias = []
    for linha in range(TAMANHO):
        for coluna in range(TAMANHO):
            if tabuleiro[linha][coluna] == 0:
                vazias.append((linha, coluna))
    return vazias




def adicionar_peca(tabuleiro):
    """Sorteia uma casa vazia e coloca nela um 2 (90%) ou um 4 (10%)."""
    vazias = casas_vazias(tabuleiro)
    if len(vazias) == 0:
        return
    linha, coluna = random.choice(vazias)
    if random.random() < CHANCE_DO_4:
        tabuleiro[linha][coluna] = 4
    else:
        tabuleiro[linha][coluna] = 2




def maior_peca(tabuleiro):
    """Procura o maior número do tabuleiro."""
    maior = 0
    for linha in tabuleiro:
        for valor in linha:
            if valor > maior:
                maior = valor
    return maior




def desenhar_peca(valor, com_numero):
    """Devolve o texto de UMA casa (7 caracteres de largura), já colorido.
    com_numero=False desenha só o fundo (parte de cima e de baixo da peça)."""
    if com_numero and valor != 0:
        texto = str(valor).center(7)
    elif com_numero and not USAR_CORES:
        texto = "   .   "
    else:
        texto = " " * 7
    if USAR_CORES:
        cor = CORES.get(valor, COR_GIGANTE)
        return cor + texto + FIM_COR
    return texto




def mostrar_tabuleiro(tabuleiro, apelido, pontos, recorde, segundos, jogadas, mensagem):
    """Desenha o placar (HUD), o tabuleiro e a mensagem da última jogada."""
    limpar_tela()
    print("  ================ 2 0 4 8 ================")
    print(f"  JOGADOR: {apelido:<10}  HI-SCORE: {formatar_pontos(recorde)}")
    print(f"  PONTOS:  {formatar_pontos(pontos)}     TEMPO: {formatar_tempo(segundos)}")
    print(f"  JOGADAS: {jogadas:<10}  MAIOR PEÇA: {maior_peca(tabuleiro)}")
    print()
    for linha in tabuleiro:
        # Cada linha do tabuleiro ocupa 3 linhas da tela para a peça ficar "quadrada":
        # fundo em cima, número no meio, fundo embaixo.
        for parte in ("cima", "meio", "baixo"):
            texto = "  "
            for valor in linha:
                texto += desenhar_peca(valor, parte == "meio") + " "
            print(texto)
        print()
    print(f"  >> {mensagem}")
    print("  [W] cima  [A] esquerda  [S] baixo  [D] direita  [Q] desistir")




