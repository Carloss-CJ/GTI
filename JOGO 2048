# PARTE 4 - PLACAR, RANKING E ESTATÍSTICAS                       (Integrante 4)
# ------------------------------------------------------------------------------
# Cada partida vira UMA LINHA no arquivo placar_2048.txt, separada por ";":
#     APELIDO;PONTOS;TEMPO_EM_SEGUNDOS;MAIOR_PECA;JOGADAS;DATA
#     CARLOS;2340;252;256;213;08/11/2026 22:40
# Ao ler o arquivo, cada linha vira um DICIONÁRIO com esses campos.
# ==============================================================================


def carregar_partidas():
    """Lê o arquivo do placar e devolve uma lista de dicionários (um por partida)."""
    partidas = []
    if not os.path.exists(ARQUIVO_PLACAR):
        return partidas      # ninguém jogou ainda
    with open(ARQUIVO_PLACAR, "r", encoding="utf-8") as arquivo:
        for linha in arquivo:
            campos = linha.strip().split(";")
            if len(campos) != 6:
                continue     # linha vazia ou estragada: ignora
            try:
                partida = {
                    "apelido": campos[0],
                    "pontos": int(campos[1]),
                    "tempo": int(campos[2]),
                    "maior_peca": int(campos[3]),
                    "jogadas": int(campos[4]),
                    "data": campos[5],
                }
            except ValueError:
                continue     # tinha texto onde devia ter número: ignora
            partidas.append(partida)
    return partidas




def salvar_partida(apelido, pontos, segundos, maior, jogadas):
    """Acrescenta a partida no final do arquivo (modo "a" = append)."""
    data = datetime.now().strftime("%d/%m/%Y %H:%M")
    with open(ARQUIVO_PLACAR, "a", encoding="utf-8") as arquivo:
        arquivo.write(f"{apelido};{pontos};{segundos};{maior};{jogadas};{data}\n")




def e_melhor(a, b):
    """True se a partida 'a' é melhor que a 'b'.
    Mais pontos ganha. Se empatar nos pontos, ganha quem fez em MENOS tempo."""
    if a["pontos"] != b["pontos"]:
        return a["pontos"] > b["pontos"]
    return a["tempo"] < b["tempo"]




def ordenar_ranking(partidas):
    """Ordena com o algoritmo BUBBLE SORT: compara vizinhos e troca de lugar
    quando o de trás é melhor. Repetindo, os melhores "sobem" para o topo."""
    lista = partidas[:]      # cópia, para não mexer na lista original
    n = len(lista)
    for i in range(n - 1):
        for j in range(n - 1 - i):
            if e_melhor(lista[j + 1], lista[j]):
                lista[j], lista[j + 1] = lista[j + 1], lista[j]
    return lista




def obter_recorde():
    """Maior pontuação já salva (o HI-SCORE). Se não tiver nenhuma, é 0."""
    recorde = 0
    for partida in carregar_partidas():
        if partida["pontos"] > recorde:
            recorde = partida["pontos"]
    return recorde




def calcular_posicao(pontos, segundos):
    """Em que lugar do ranking essa pontuação fica? 1 + quantas são melhores."""
    nova = {"pontos": pontos, "tempo": segundos}
    posicao = 1
    for partida in carregar_partidas():
        if e_melhor(partida, nova):
            posicao += 1
    return posicao




def mostrar_ranking():
    """Mostra o TOP 10 no estilo fliperama."""
    limpar_tela()
    ranking = ordenar_ranking(carregar_partidas())
    print("  ======================= HIGH SCORES =======================")
    print()
    if len(ranking) == 0:
        print("  Nenhuma partida salva ainda. Seja o primeiro!")
    else:
        print("  POS  JOGADOR        PONTOS   TEMPO   PEÇA   DATA")
        posicao = 1
        for p in ranking[:TOP]:
            print(f"  {posicao:>2}º  {p['apelido']:.<12}  {formatar_pontos(p['pontos'])}"
                  f"   {formatar_tempo(p['tempo'])}  {p['maior_peca']:>5}   {p['data'][:10]}")
            posicao += 1
    pausar()




def mostrar_estatisticas():
    """Indicadores gerais do jogo + gráfico de barras feito com caracteres."""
    limpar_tela()
    partidas = carregar_partidas()
    print("  ====================== ESTATÍSTICAS ======================")
    print()
    if len(partidas) == 0:
        print("  Ainda não há partidas salvas.")
        pausar()
        return


    soma_pontos = 0
    soma_tempo = 0
    maior = 0
    vitorias = 0
    acumulado = {}   # dicionário: apelido -> soma dos pontos de todas as partidas
    for p in partidas:
        soma_pontos += p["pontos"]
        soma_tempo += p["tempo"]
        if p["maior_peca"] > maior:
            maior = p["maior_peca"]
        if p["maior_peca"] >= META:
            vitorias += 1
        if p["apelido"] in acumulado:
            acumulado[p["apelido"]] += p["pontos"]
        else:
            acumulado[p["apelido"]] = p["pontos"]


    total = len(partidas)
    print(f"  Partidas jogadas ............ {total}")
    print(f"  Jogadores diferentes ........ {len(acumulado)}")
    print(f"  Média de pontos ............. {soma_pontos // total}")
    print(f"  Tempo médio por partida ..... {formatar_tempo(soma_tempo // total)}")
    print(f"  Maior peça já alcançada ..... {maior}")
    print(f"  Vitórias (chegou ao 2048) ... {vitorias}")


    # Gráfico de barras: pontuação acumulada de cada jogador (do maior pro menor)
    print()
    print("  PONTUAÇÃO ACUMULADA POR JOGADOR")
    jogadores = []
    for apelido in acumulado:
        jogadores.append({"apelido": apelido, "pontos": acumulado[apelido], "tempo": 0})
    jogadores = ordenar_ranking(jogadores)      # reaproveita o bubble sort
    maior_total = jogadores[0]["pontos"]
    for j in jogadores[:TOP]:
        if maior_total > 0:
            tamanho = j["pontos"] * 30 // maior_total   # a maior barra tem 30 blocos
        else:
            tamanho = 0
        print(f"  {j['apelido']:<10} {'█' * tamanho} {j['pontos']}")
    pausar()




